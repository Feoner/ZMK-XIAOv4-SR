#include <behaviors.dtsi>
#include <behaviors/mouse_keys.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
                &kp F1          &kp F2  &kp F3  &kp F4          &kp F5                             &kp F6              &kp F7     &kp F8     &kp F9         &kp F10  &kp F11   &kp EQUAL
                &kp ESC         &kp N1  &kp N2  &kp N3          &kp N4                             &kp N5              &kp N6     &kp N7     &kp N8         &kp N9   &kp N0    &kp MINUS
                &kp TAB         &kp Q   &kp W   &kp E           &kp R                              &kp T               &kp Y      &kp U      &kp I          &kp O    &kp P     &kp BACKSLASH
                &kp LCTRL       &kp A   &kp S   &kp D           &kp F                              &kp G               &kp H      &kp J      &kp K          &kp L    &kp SEMI  &kp SQT
                &kp LEFT_SHIFT  &kp Z   &kp X   &kp C           &kp V                              &kp B               &kp N      &kp M      &kp COMMA      &kp DOT  &kp FSLH  &kp RIGHT_SHIFT
                                                                                                   &kp C_PLAY_PAUSE
                                    &kp C_MUTE      &kp BACKSPACE                      &kp LEFT_GUI        &mo 2
                                    &kp LG(LS(N4))  &kp C_AC_DESKTOP_SHOW_ALL_WINDOWS  &mo 1               &kp ENTER  &kp SPACE  &kp RIGHT_GUI
            >;

            /* Encoder rotation is configured via sensor-bindings. [1](https://zmk.dev/docs/features/encoders)
             * Encoder 1: true vertical mouse wheel scroll via &msc. [2](https://zmk.dev/docs/keymaps/behaviors/mouse-emulation)[3](https://docs.moergo.com/layout-editor-guide/mouse-emulation/)
             * Encoder 2: Page Up/Down (unchanged).
             */
            sensor-bindings = <&msc SCRL_UP &msc SCRL_DOWN  &inc_dec_kp PG_UP PG_DN>;
        };

        layer_1 {
            bindings = <
                &bt BT_CLR       &bt BT_SEL 0     &bt BT_SEL 1    &bt BT_SEL 2    &bt BT_SEL 3  &bt BT_SEL 4    &bt BT_DISC 4  &bt BT_DISC 3  &bt BT_DISC 2  &bt BT_DISC 1  &bt BT_DISC 0  &bt BT_CLR_ALL
                &trans           &trans           &trans          &trans          &trans        &trans          &trans         &trans         &trans         &trans         &trans         &kp BACKSLASH
                &trans           &trans           &trans          &kp UP_ARROW    &trans        &trans          &kp PAGE_UP    &trans         &trans         &trans         &trans         &kp NON_US_BACKSLASH
                &rgb_ug RGB_TOG  &rgb_ug RGB_EFF  &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT     &trans          &trans         &mkp LCLK      &mkp RCLK      &trans         &kp MINUS      &trans
                &trans           &trans           &trans          &trans          &trans        &trans          &kp PAGE_DOWN  &trans         &trans         &trans         &trans         &kp RIGHT_SHIFT
                                                                                                &trans
                                                  &trans          &trans        &trans          &bootloader
                                                  &trans          &trans        &trans          &trans         &trans         &trans
            >;

            sensor-bindings = <&msc SCRL_UP &msc SCRL_DOWN  &inc_dec_kp PG_UP PG_DN>;
        };

        layer_2 {
            bindings = <
                &trans  &trans  &trans  &trans       &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans       &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans       &trans  &trans    &trans  &kp N7  &kp N8  &kp N9  &trans  &trans
                &trans  &trans  &trans  &trans       &trans  &trans    &trans  &kp N4  &kp N5  &kp N6  &trans  &trans
                &trans  &trans  &trans  &trans       &trans  &trans    &trans  &kp N1  &kp N2  &kp N3  &trans  &trans
                                             &trans
                        &trans       &trans  &trans    &trans
                        &bootloader  &trans  &trans    &trans  &trans  &trans
            >;

            sensor-bindings = <&msc SCRL_UP &msc SCRL_DOWN  &inc_dec_kp PG_UP PG_DN>;
        };

        layer_3 {
            bindings = <
                &trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
                                        &trans
                        &trans  &trans  &trans    &trans
                        &trans  &trans  &trans    &trans  &trans  &trans
            >;

            sensor-bindings = <&msc SCRL_UP &msc SCRL_DOWN  &inc_dec_kp PG_UP PG_DN>;
        };

        layer_4 {
            bindings = <
                &trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
                                        &trans
                        &trans  &trans  &trans    &trans
                        &trans  &trans  &trans    &trans  &trans  &trans
            >;

            sensor-bindings = <&msc SCRL_UP &msc SCRL_DOWN  &inc_dec_kp PG_UP PG_DN>;
        };

        layer_5 {
            bindings = <
                &trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
                                        &trans
                        &trans  &trans  &trans    &trans
                        &trans  &trans  &trans    &trans  &trans  &trans
            >;

            sensor-bindings = <&msc SCRL_UP &msc SCRL_DOWN  &inc_dec_kp PG_UP PG_DN>;
        };
    };
};
